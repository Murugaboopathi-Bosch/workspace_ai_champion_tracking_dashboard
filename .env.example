genaiplatform-farm-subscription-key=00e8f8a7482e49949a8f7c6de20d59d7
openai_base_url=https://aoai-farm.bosch-temp.com/api/openai/deployments/askbosch-prod-farm-openai-gpt-4o-mini-2024-07-18/chat/completions?api-version=2024-08-01-preview
